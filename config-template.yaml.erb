# ========================
# 规则
# ========================
rules:
  # values 自定义规则优先级最高。
<% local_rules.each do |rule| -%>
  - <%= rule %>
<% end -%>
<% proxy_rules.each do |rule| -%>
  - <%= rule_for_policy(rule, 'proxy') %>
<% end -%>
<% direct_rules.each do |rule| -%>
  - <%= rule_for_policy(rule, 'DIRECT') %>
<% end -%>
<% group_rules.each do |group, rules| -%>
<% rules.each do |rule| -%>
  - <%= rule_for_policy(rule, group) %>
<% end -%>
<% end -%>
<% wireguard.rules.each do |rule| -%>
  - <%= yaml_scalar(rule) %>
<% end -%>
  - PROCESS-NAME,ssh,DIRECT
  - PROCESS-NAME,scp,DIRECT
  - PROCESS-NAME,sftp,DIRECT
  - PROCESS-NAME,rsync,DIRECT
  - DST-PORT,22,DIRECT
<% custom_rule_providers.each do |provider| -%>
  - <%= custom_rule_provider_rule(provider) %>
<% end -%>

