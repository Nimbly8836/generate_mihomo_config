# ========================
# 复用锚点
# ========================

# 通用策略组模板
pr: &pr
  # 手动选择类型
  type: select
  proxies:
    - default
    - my_proxy
    - hk
    - jp
    - tw
    - us
    - sg
    - others
    - all_nodes
    - DIRECT
<% local_proxy_group_names_for("steam", "google", "telegram", "twitter", "ehentai", "bilibili_sea", "bahamut", "youtube", "netflix", "spotify", "github", "other").each do |name| -%>
    - <%= yaml_scalar(name) %>
<% end -%>

# 亚洲站点优先直连，不包含香港
direct_asia_no_hk_pr: &direct_asia_no_hk_pr
  type: select
  proxies:
    - DIRECT
    - my_proxy
    - jp
    - tw
    - sg
    - others
<% local_proxy_group_names_for("apple").each do |name| -%>
    - <%= yaml_scalar(name) %>
<% end -%>

# 亚洲站点优先直连，包含香港
direct_asia_pr: &direct_asia_pr
  type: select
  proxies:
    - DIRECT
    - my_proxy
    - hk
    - jp
    - tw
    - sg
    - others
<% local_proxy_group_names_for("bilibili").each do |name| -%>
    - <%= yaml_scalar(name) %>
<% end -%>

# 订阅提供者的默认参数
provider_defaults: &provider_defaults
  # 从远端拉取订阅，默认直连，保证无代理节点时仍可更新。
  type: http
  interval: 3600
  proxy: DIRECT
  health-check:
    # 是否启用健康检查
    enable: true
    # 健康检查地址
    url: "https://www.gstatic.com/generate_204"
    # 健康检查间隔，单位秒
    interval: 300

# 使用订阅节点的策略组默认参数
provider_use_defaults: &provider_use_defaults
  # Always keep a local DIRECT-capable path, even when subscriptions are absent.
  type: select
  proxies:
    - my_proxy
<% unless provider_names.empty? -%>
  # Use all remote subscriptions configured in values.
  use:
<% provider_names.each do |name| -%>
    - <%= yaml_scalar(name) %>
<% end -%>
<% end -%>

# 地区自动测速组的默认参数
regional_url_test_defaults: &regional_url_test_defaults
  type: url-test
<%= render_hash(url_test, indent: 2) -%>
<% if provider_names.empty? -%>
  # No subscription: my_proxy itself falls back to DIRECT when necessary.
  proxies:
    - my_proxy
<% else -%>
  # With providers present, only filtered provider nodes enter the region group.
  # This prevents DIRECT or an unrelated local node from winning the url-test.
  use:
<% provider_names.each do |name| -%>
    - <%= yaml_scalar(name) %>
<% end -%>
<% end -%>

# ========================
# 远程订阅
# ========================

proxy-providers:
<% if proxy_providers.empty? -%>
  # 没有远程订阅时保留空映射
  {}
<% else -%>
<% proxy_providers.each do |provider| -%>
  # 远程订阅：<%= provider.fetch("name") %>
  <%= provider.fetch("name") %>:
<% if provider_uses_defaults?(provider) -%>
    <<: *provider_defaults
<% end -%>
<%= render_hash(provider_body(provider), indent: 4) -%>
<% end -%>
<% end -%>

# ========================
# 规则集订阅
# ========================

rule-providers:
  # MetaCubeX MRS 规则集；全部默认直连下载，避免依赖尚未可用的代理组。
<% TemplateContext::BUILTIN_DOMAIN_RULE_SOURCES.each do |name, source| -%>
  <%= name %>:
    type: http
    behavior: domain
    format: mrs
    url: <%= yaml_scalar("https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/#{source}.mrs") %>
    path: <%= yaml_scalar("./rule_providers/#{name}.mrs") %>
    interval: 86400
    proxy: DIRECT
<% end -%>
<% TemplateContext::BUILTIN_IP_RULE_SOURCES.each do |name, source| -%>
  <%= name %>:
    type: http
    behavior: ipcidr
    format: mrs
    url: <%= yaml_scalar("https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geoip/#{source}.mrs") %>
    path: <%= yaml_scalar("./rule_providers/#{name}.mrs") %>
    interval: 86400
    proxy: DIRECT
<% end -%>
  # 恢复旧版广告聚合源；MRS 与上游 YAML 同系列，8 小时刷新。
  adblock_mihomo:
    type: http
    behavior: domain
    format: mrs
    url: https://raw.githubusercontent.com/217heidai/adblockfilters/main/rules/adblockmihomo.mrs
    path: ./rule_providers/adblock_mihomo.mrs
    interval: 28800
    proxy: DIRECT
<% unless custom_rule_providers.empty? -%>

  # values 文件中的自定义规则集。
<% custom_rule_providers.each do |provider| -%>
  <%= yaml_scalar(provider.fetch("name")) %>:
<%= render_hash(custom_rule_provider_body(provider), indent: 4) -%>
<% end -%>
<% end -%>

# ========================
# 本地静态节点
# ========================

proxies:
<%= render_list(local_proxies + wireguard.proxies, indent: 2) -%>

# ========================
# 策略组
# ========================

<% simple_groups = %w[ai game media chat dev cloud download adult china other] -%>
<% detailed_groups = {
  'openai' => 'ai', 'claude' => 'ai', 'gemini' => 'ai', 'copilot' => 'ai',
  'steam' => 'game', 'epic' => 'game', 'blizzard' => 'game', 'ps' => 'game',
  'xbox' => 'game', 'nintendo' => 'game',
  'youtube' => 'media', 'netflix' => 'media', 'disney' => 'media', 'prime' => 'media',
  'hbo' => 'media', 'twitch' => 'media', 'spotify' => 'media',
  'telegram' => 'chat', 'discord' => 'chat', 'whatsapp' => 'chat', 'x' => 'chat',
  'github' => 'dev', 'gitlab' => 'dev', 'docker' => 'dev',
  'google' => 'cloud', 'apple' => 'cloud', 'microsoft' => 'cloud', 'onedrive' => 'cloud'
} -%>
<% region_groups = %w[hk jp tw sg us kr eu others] -%>
<% built_in_groups = %w[default proxy my_proxy ad_block all_nodes final domestic other] + simple_groups + detailed_groups.keys + region_groups -%>
proxy-groups:
  # 全局入口；保留 default 名称兼容已有配置。
  - name: default
    type: select
    proxies:
      - proxy
      - ai
      - game
      - media
      - chat
      - dev
      - cloud
      - download
      - adult
      - china
      - all_nodes
      - DIRECT
<% local_proxy_group_names_for(*built_in_groups).each do |name| -%>
      - <%= yaml_scalar(name) %>
<% end -%>

  # 主代理组。
  - name: proxy
    type: select
    proxies:
      - all_nodes
      - hk
      - jp
      - tw
      - sg
      - us
      - kr
      - eu
      - others
      - my_proxy
      - DIRECT
<% local_proxy_group_names_for(*built_in_groups).each do |name| -%>
      - <%= yaml_scalar(name) %>
<% end -%>

  # 手写节点入口；为空时自动回退 DIRECT。
  - name: my_proxy
    type: select
    proxies:
<% if local_proxy_names.empty? -%>
      - DIRECT
<% else -%>
<% local_proxy_names.each do |name| -%>
      - <%= yaml_scalar(name) %>
<% end -%>
<% end -%>

  - name: ad_block
    type: select
    proxies:
      - REJECT
      - DIRECT
<% unless local_proxy_groups.empty? -%>

  # 用户自定义策略组。
<%= render_list(local_proxy_groups, indent: 2) -%>
<% end -%>

<% unless wireguard.groups.empty? -%>
  # 内网 WG 专用组，不加入普通代理出口；可手动切到 REJECT 停用。
<%= render_list(wireguard.groups, indent: 2) -%>
<% end -%>

  # 简单模式入口；详细模式同样保留，作为详细服务组的父级。
<% simple_groups.each do |name| -%>
  - name: <%= name %>
    type: select
    proxies:
<% if name == 'china' -%>
      - DIRECT
      - proxy
<% else -%>
      - proxy
<% end -%>
      - hk
      - jp
      - tw
      - sg
      - us
      - kr
      - eu
      - others
      - DIRECT
<% blocked = [name] + detailed_groups.select { |_, parent| parent == name }.keys -%>
<% local_proxy_group_names_for(*built_in_groups).each do |custom_name| -%>
      - <%= yaml_scalar(custom_name) %>
<% end -%>
<% end -%>

<% if group_mode == 'detailed' -%>
  # 详细服务组默认先使用对应的简单父组。
<% detailed_groups.each do |name, parent| -%>
  - name: <%= name %>
    type: select
    proxies:
      - <%= parent %>
      - proxy
      - hk
      - jp
      - tw
      - sg
      - us
      - kr
      - eu
      - others
      - DIRECT
<% local_proxy_group_names_for(*built_in_groups).each do |custom_name| -%>
      - <%= yaml_scalar(custom_name) %>
<% end -%>
<% end -%>
<% end -%>

  # 最终兜底与旧名称兼容组。
  - name: final
    type: select
    proxies:
      - proxy
      - DIRECT
<% local_proxy_group_names_for(*built_in_groups).each do |name| -%>
      - <%= yaml_scalar(name) %>
<% end -%>

  - name: domestic
    type: select
    proxies:
      - china

  # 所有订阅节点和全局自动测速。
  - name: all_nodes
    <<: *provider_use_defaults


  # 地区组支持手动选择；默认项是隐藏的 url-test 自动组。
  - name: hk
    <<: *provider_use_defaults
    default-selected: hk_auto
    proxies: [hk_auto, my_proxy]
    filter: "(?i)(🇭🇰|香港|港(?![澳台])|(^|[^a-z])(hk|hkg|hong[ _-]?kong)([^a-z]|$))"
    exclude-filter: "(?i)(澳門|澳门|macao|macau)"

  - name: hk_auto
    <<: *regional_url_test_defaults
    hidden: true
    filter: "(?i)(🇭🇰|香港|港(?![澳台])|(^|[^a-z])(hk|hkg|hong[ _-]?kong)([^a-z]|$))"
    exclude-filter: "(?i)(澳門|澳门|macao|macau)"


  - name: jp
    <<: *provider_use_defaults
    default-selected: jp_auto
    proxies: [jp_auto, my_proxy]
    filter: "(?i)(🇯🇵|日本|(^|[^a-z])(jp|jpn|japan|tokyo|osaka)([^a-z]|$))"

  - name: jp_auto
    <<: *regional_url_test_defaults
    hidden: true
    filter: "(?i)(🇯🇵|日本|(^|[^a-z])(jp|jpn|japan|tokyo|osaka)([^a-z]|$))"


  - name: tw
    <<: *provider_use_defaults
    default-selected: tw_auto
    proxies: [tw_auto, my_proxy]
    filter: "(?i)(🇹🇼|台湾|台灣|(^|[^a-z])(tw|twn|tpe|taipei|taiwan)([^a-z]|$))"
    exclude-filter: "(?i)(hong[ _-]?kong|hk|hkg|macau|macao)"

  - name: tw_auto
    <<: *regional_url_test_defaults
    hidden: true
    filter: "(?i)(🇹🇼|台湾|台灣|(^|[^a-z])(tw|twn|tpe|taipei|taiwan)([^a-z]|$))"
    exclude-filter: "(?i)(hong[ _-]?kong|hk|hkg|macau|macao)"


  - name: sg
    <<: *provider_use_defaults
    default-selected: sg_auto
    proxies: [sg_auto, my_proxy]
    filter: "(?i)(🇸🇬|新加坡|狮城|獅城|(^|[^a-z])(sg|sgp|singapore)([^a-z]|$))"

  - name: sg_auto
    <<: *regional_url_test_defaults
    hidden: true
    filter: "(?i)(🇸🇬|新加坡|狮城|獅城|(^|[^a-z])(sg|sgp|singapore)([^a-z]|$))"


  - name: us
    <<: *provider_use_defaults
    default-selected: us_auto
    proxies: [us_auto, my_proxy]
    filter: "(?i)(🇺🇸|美国|美國|(^|[^a-z])(us|usa|united[ _-]?states|america)([^a-z]|$)|los[ _-]?angeles|san[ _-]?jose|new[ _-]?york|seattle|chicago)"
    exclude-filter: "(?i)(australia|au|aus)"

  - name: us_auto
    <<: *regional_url_test_defaults
    hidden: true
    filter: "(?i)(🇺🇸|美国|美國|(^|[^a-z])(us|usa|united[ _-]?states|america)([^a-z]|$)|los[ _-]?angeles|san[ _-]?jose|new[ _-]?york|seattle|chicago)"
    exclude-filter: "(?i)(australia|au|aus)"


  - name: kr
    <<: *provider_use_defaults
